---
/**
 * Otter "Flip" block equivalent, animation flipX-rev (SPEC.md §6.6).
 * Hover flips on desktop; tap toggles on touch devices (class "is-flipped").
 */
interface Props {
  title: string;
  lead: string;
  body: string;
  practice: string;
  mobileHeight?: number;
}
const { title, lead, body, practice, mobileHeight = 400 } = Astro.props;
---
<div class="o-flip" style={`--flip-mobile-h:${mobileHeight}px`} tabindex="0" role="group" aria-label={`${title} virtue card`}>
  <div class="o-flip-inner">
    <div class="o-flip-front">
      <div class="o-flip-content">
        <h3 class="o-flip-title">{title}</h3>
        <p class="o-flip-desc"><strong>{lead}</strong><br />{body}</p>
      </div>
    </div>
    <div class="o-flip-back">
      <div class="o-flip-content">
        <h2 class="o-flip-back-title">In practice:</h2>
        <h4 class="o-flip-back-text">{practice}</h4>
      </div>
    </div>
  </div>
</div>

<style>
  .o-flip {
    position: relative;
    width: 100%;
    height: 240px;
    padding: 20px;
    perspective: 1000px;
    cursor: pointer;
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .o-flip { height: var(--flip-mobile-h); }
  }
  .o-flip-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s;
  }
  .o-flip-front, .o-flip-back {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 30px;
    border-radius: 10px;
    background: var(--flip-gradient);
    color: #ffffff;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
  }
  .o-flip-back { transform: rotateX(180deg); }
  .o-flip-content { width: 100%; }
  .o-flip-content h2, .o-flip-content h3, .o-flip-content h4, .o-flip-content p { color: #ffffff; margin: 0; }
  .o-flip-title { font-size: 32px; font-weight: 600; line-height: 1.2; margin-bottom: 12px !important; }
  .o-flip-desc { font-size: 24px; line-height: 1.3; }
  .o-flip-back-title { font-size: 32px; font-weight: 700; line-height: 1.2; margin-bottom: 12px !important; }
  .o-flip-back-text { font-size: 20px; font-weight: 700; line-height: 1.4; }
  @media (max-width: 600px) {
    .o-flip-title { font-size: 26px; }
    .o-flip-desc { font-size: 19px; }
    .o-flip-back-title { font-size: 26px; }
    .o-flip-back-text { font-size: 17px; }
  }

  /* flipX-rev: flips upward */
  @media (hover: hover) {
    .o-flip:hover .o-flip-inner,
    .o-flip:focus-visible .o-flip-inner { transform: rotateX(-180deg); }
  }
  .o-flip.is-flipped .o-flip-inner { transform: rotateX(-180deg); }
</style>

<script>
  // Tap-to-flip for touch devices; keyboard users can press Enter/Space.
  document.querySelectorAll<HTMLElement>('.o-flip').forEach((card) => {
    card.addEventListener('click', () => card.classList.toggle('is-flipped'));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        card.classList.toggle('is-flipped');
      }
    });
  });
</script>
